# usage: feeze
#

set -eu

FEEZE_CMD=$0
FEEZE_BIN="$(dirname "$(readlink -f "$0")")"

: "${FEEZE_HOME="$FEEZE_BIN/.."}"
: "${FEEZE_JAVA=java}"
: "${FEEZE_JAVA_ADDITIONAL_CLASSPATH=""}"
: "${FEEZE_JAVA_CLASSPATH="$FEEZE_HOME/classes"}"

# output text explaining how to set path to 'java' command correctly:
#
fix_java="Please set \$PATH to include OpenJDK 25's 'bin' directory or set \$FEEZE_JAVA
to the full path of the OpenJDK 25's 'java' command.

To install OpenJDK 25, on ubuntu, do

  > sudo apt update
  > sudo apt install -y openjdk-25-jdk

on Fedora,

  > sudo yum install java-25-openjdk.x86_64

To set the PATH, you might have to do

  > export PATH=/usr/lib/jvm/jre-25/bin:$PATH

or similar."

# output text explaining how to install libgc.so corretly
#
fix_libgc="To install libgc.so, on unbuntu, do

  > sudo apt-get update
  > sudo apt-get install libgc

on Fedora, do

  > sudo yum install libgc
"
# Use 'command -v' instead of 'which' for compatibility with Fedora/RHEL
command -v "$FEEZE_JAVA" >/dev/null || (
    echo 1>&2 "*** java ($FEEZE_JAVA) not found in \$PATH."
    echo 1>&2 "$fix_java"
    exit 1)

# Get main Java version number
java_version=$($FEEZE_JAVA -version 2>&1 | head -n1 | grep -oE 'version "[0-9]+\.' | grep -oE '[0-9]+')

# Check if version is at least 25
if test "$java_version" -lt 25;  then
    echo 1>&2 "*** Java version of command '$FEEZE_JAVA' must be at least 25, it is $java_version."
    echo 1>&2 "$fix_java"
    exit 1
fi

if !(command -v ldconfig >/dev/null); then
    echo 1>&2 "*** ldconfig not installed, libgc installation detection does not work."
elif !(ldconfig -p | grep libgc\.so >/dev/null); then
    echo 1>&2 "*** libgc.so not installed."
    echo 1>&2 "$fix_libgc"
    exit 1
fi

if [ -n "$FEEZE_JAVA_ADDITIONAL_CLASSPATH" ]
then
  FEEZE_JAVA_CLASSPATH="$FEEZE_JAVA_CLASSPATH:$FEEZE_JAVA_ADDITIONAL_CLASSPATH"
fi
: "${FEEZE_JAVA_STACK_SIZE=1m}"
: "${FEEZE_JAVA_OPTIONS="-Xss$FEEZE_JAVA_STACK_SIZE"}"
: "${FEEZE_JAVA_ADDITIONAL_OPTIONS=--enable-preview --enable-native-access=ALL-UNNAMED}"

# On some systems, swing does not seem to automatically get the correct system font size.
# As a workaround, set this factor to get a larger default font.
#
: "${UI_SCALE=}"   # make sure $UI_SCALE is defined to avoid error

# shellcheck disable=SC2086
$FEEZE_JAVA \
  $FEEZE_JAVA_OPTIONS \
  $FEEZE_JAVA_ADDITIONAL_OPTIONS \
  --class-path "$FEEZE_JAVA_CLASSPATH" \
  -Dfile.encoding=UTF-8 \
  -Dfeeze.home="$FEEZE_HOME" \
  -Dfeeze.command="$FEEZE_CMD" \
  ${UI_SCALE:+-Dsun.java2d.uiScale=$UI_SCALE} \
  -p "${FEEZE_HOME}" \
  -m @MAIN_CLASS@ \
  "$@"
